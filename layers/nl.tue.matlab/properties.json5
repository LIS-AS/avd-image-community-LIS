{
  version: "v2.1",
  name: "nl.tue.matlab",
  description: "Example description: short note on what this layer does",
  author: {
    name: "Dirk van Nunen",
    email: "d.j.v.nunen@tue.nl"
  },
  platform_version: "2",
  network: {
    // HTTP(s) hosts that are whitelisted in the proxy
    // note that the application must be configured to use the proxy or support Windows IE proxy settings
    //
    // list of whitelisted hostname:port combinations. Supports * wildcards
    http_proxy_whitelist: [
    "login.mathworks.com:*",
	  "signin.mathworks.com:*",
    "licensing.mathworks.com:*",
	  "services.mathworks.com:*",
	  "www.mathworks.com:*",
    "login.microsoftonline.com:*",
    "aadcdn.msauth.net:*",
    "aadcdn.msauthimages.net:*",
    "autologon.microsoftazuread-sso.com:*",
	  "sts.windows.net:*"
	  //"engine.surfconext.nl:*"
    ],
  },
}